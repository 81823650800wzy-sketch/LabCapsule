{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/81823650800wzy-sketch/LabCapsule/shared/memory_snapshot_v1.schema.json",
  "title": "LabCapsule synchronized memory snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deviceId", "revision", "updatedAt", "facts", "recentSessions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "deviceId": {"type": "string", "pattern": "^lc-[0-9a-f]{12}$"},
    "revision": {"type": "integer", "minimum": 0},
    "updatedAt": {"type": "string", "format": "date-time"},
    "characterId": {"type": "string", "maxLength": 64},
    "facts": {
      "type": "array", "maxItems": 80,
      "items": {"type": "string", "maxLength": 240}
    },
    "recentSessions": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "startedAt", "sampleCount"],
        "properties": {
          "id": {"type": "string", "maxLength": 64},
          "name": {"type": "string", "maxLength": 120},
          "startedAt": {"type": "string", "format": "date-time"},
          "sampleCount": {"type": "integer", "minimum": 0},
          "summary": {"type": "string", "maxLength": 600}
        }
      }
    }
  }
}
